  "limits": [
    "Direct BL/B-to-PLT transfers only; indirect calls, inline syscalls, libc and other modules are not covered",
    "Argument values are conservative local MOV-chain findings, not whole-program control-flow proof",
    "Unknown level/option/flags must not be treated as absence of an operation"
  ],
  "scope": "Expanded exact-firmware direct receive/read/socket-call static inventory",
  "reviewed_helpers": [
    {
      "function": "0x138f068",
      "peek_call": "0x138f0b4",
      "flags": "0x62 (MSG_PEEK|MSG_TRUNC|MSG_DONTWAIT)",
      "behavior": "Peeks four bytes, compares the value with a buffered value, and consumes mismatched datagrams using flags0x60 before retrying; socket port/type ownership not established by this function alone"
    },
    {
      "function": "0x247c420",
      "recv_call": "0x247c4e0",
      "recvfrom_call": "0x247c54c",
      "behavior": "Generic locked receiver chooses recv when source-address outputs are absent, recvfrom otherwise; both pass flags0"
    }
  ],
  "conclusions": [
    "No direct B-to-PLT tail transfers found among the targeted symbols; inventory also includes BL calls",
    "Six direct recv calls include real MSG_PEEK usage; earlier recvfrom-only inventory is not sufficient to establish no-peek native behavior",
    "The 29 direct syscall calls resolve to AArch64 gettid178, not socket receive syscalls",
    "The 39 read sites and generic recv helper require socket-ownership/runtime correlation before claiming UDP policy coverage"
  ],
